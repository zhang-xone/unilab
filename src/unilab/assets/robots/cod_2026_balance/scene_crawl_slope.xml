    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="slope_material" rgba="0.6 0.3 0.2 1"/>
    <material name="plateau_material" rgba="0.4 0.5 0.4 1"/>
    <material name="ground_material" rgba="0.35 0.4 0.45 1"/>

    <mesh name="crawl_slope_slope" file="crawl_slope/slope.obj"/>
