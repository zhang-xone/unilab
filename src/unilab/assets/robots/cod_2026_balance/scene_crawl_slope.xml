    <mesh name="crawl_slope_ground" file="crawl_slope/ground.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1" friction="1.0 0.005 0.0001"/>
    <geom name="crawl_slope_slope" type="mesh" mesh="crawl_slope_slope"
          material="slope_material" contype="1" conaffinity="1"
          friction="1.0 0.005 0.0001"/>
    <!-- <geom name="crawl_slope_plateau" type="mesh" mesh="crawl_slope_plateau"
          material="plateau_material" contype="1" conaffinity="1"
          friction="1.0 0.005 0.0001"/> -->
    <geom name="crawl_slope_ground" type="mesh" mesh="crawl_slope_ground"
          material="ground_material" contype="1" conaffinity="1"
          friction="1.0 0.005 0.0001"/>
  </worldbody>

  <keyframe>
    <key name="home" qpos="0.000000 -3.000000 0.400000 0.707107 0.000000 0.000000 0.707107 0.239130 -0.520634 0.284200 -0.486861 -0.519644 0.563946 -0.874393 0.162861 -0.480007 0.287870 -0.455611 -0.497974 0.507563 0.334914" />
  </keyframe>

</mujoco>