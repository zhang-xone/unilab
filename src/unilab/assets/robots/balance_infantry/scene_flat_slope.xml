<mujoco model="Balance Infantry scene with slopes">
  <include file="balance_infantry.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="pyramid_material" rgba="0.6 0.3 0.2 1"/>
    <mesh name="pyramid_slope_03" file="crawl_slope/pyramid_slope_03.obj"/>
    <mesh name="pyramid_slope_05" file="crawl_slope/pyramid_slope_05.obj"/>
    <mesh name="pyramid_slope_07" file="crawl_slope/pyramid_slope_07.obj"/>
    <mesh name="pyramid_slope_09" file="crawl_slope/pyramid_slope_09.obj"/>
    <mesh name="pyramid_slope_11" file="crawl_slope/pyramid_slope_11.obj"/>
    <mesh name="pyramid_slope_13" file="crawl_slope/pyramid_slope_13.obj"/>
    <mesh name="pyramid_slope_15" file="crawl_slope/pyramid_slope_15.obj"/>
    <mesh name="pyramid_slope" file="crawl_slope/pyramid_slope.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1" friction="1.0 0.005 0.0001"/>
    <geom name="pyramid_1" type="mesh" mesh="pyramid_slope_03" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="1.15 0.0 0.0"/>
    <geom name="pyramid_2" type="mesh" mesh="pyramid_slope_05" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="-1.15 0.0 0.0"/>
    <geom name="pyramid_3" type="mesh" mesh="pyramid_slope_07" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="0.0 1.35 0.0"/>
    <geom name="pyramid_4" type="mesh" mesh="pyramid_slope_03" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="0.0 -1.35 0.0"/>
    <geom name="pyramid_5" type="mesh" mesh="pyramid_slope_07" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="1.63 1.63 0.0"/>
    <geom name="pyramid_6" type="mesh" mesh="pyramid_slope_09" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="-1.63 1.63 0.0"/>
    <geom name="pyramid_7" type="mesh" mesh="pyramid_slope_11" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="1.63 -1.63 0.0"/>
