    <geom name="pyramid_9" type="mesh" mesh="pyramid_slope_11" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="3.1 0.0 0.0"/>
    <geom name="pyramid_10" type="mesh" mesh="pyramid_slope_13" material="pyramid_material" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" pos="-3.1 0.0 0.0"/>
